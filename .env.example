# ==============================================================================
# RepoGenius AI - Backend Environment Configuration
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to '.env' (in the project root or backend directory)
# 2. Add your Google AI Studio or Gemma-compatible API key below
# 3. Keep .env strictly private (it is ignored by .gitignore)
# ==============================================================================

# Google AI Studio / Gemma API Key
GEMMA_API_KEY=your_gemma_api_key_here

# Target Gemma Model
# Default options: gemma-4, gemma-2-9b-it, gemini-2.0-flash
GEMMA_MODEL=gemma-4

# Optional: Custom OpenAI-compatible or proxy Base URL
# Examples:
# - Google Native API: (leave commented out to use default)
# - OpenRouter: https://openrouter.ai/api/v1
# - Local vLLM/Ollama: http://localhost:11434/v1
# GEMMA_API_BASE=https://openrouter.ai/api/v1

# Server Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=False
